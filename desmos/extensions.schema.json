{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://cootshk.dev/desmos/extensions.schema.json",
    "title": "Desmos extension manifest",
    "description": "A list of all of the extensions available",
    "type": "object",
    "required": ["extensions"],
    "additionalProperties": false,
    "properties": {
        "extensions": {
            "type": "object",
            "description": "Extensions are keyed by id, which is used in almost all places.",
            "propertyNames": { "$ref": "#/$defs/id" },
            "additionalProperties": { "$ref": "#/$defs/extension" }
        },
        "defaultExtensions": {
            "type": "array",
            "description": "Extensions to load if the URL doesn't specify any",
            "items": { "$ref": "#/$defs/id" },
            "uniqueItems": true
        }
    },
    "$defs": {
        "id": {
            "type": "string",
            "description": "An extension id: lowercase, and free of the \",\" and \"@\" that separate entries and arguments in ?ext=.",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "extension": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "description"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "description": "The label in the settings panel. Defaults to the id.",
                    "minLength": 1
                },
                "description": {
                    "type": "string",
                    "description": "The tooltip on that label. Defaults to nothing."
                },
                "supports": {
                    "type": "array",
                    "description": "The supported calculators. All if omitted",
                    "items": { "$ref": "#/$defs/mode" },
                    "minItems": 1,
                    "uniqueItems": true
                },
                "file": {
                    "description": "The script inside extensions/<id>/, if not index.js. A list for an extension split across several files, which run in the order given.",
                    "anyOf": [
                        { "type": "string", "minLength": 1 },
                        {
                            "type": "array",
                            "items": { "type": "string", "minLength": 1 },
                            "minItems": 1,
                            "uniqueItems": true
                        }
                    ]
                },
                "css": {
                    "description": "A stylesheet to put into the frame before the extension runs. true is the index.css beside its index.js; a string names another file in the same folder.",
                    "default": false,
                    "anyOf": [
                        { "type": "boolean" },
                        { "type": "string", "minLength": 1 }
                    ]
                },
                "forceEnabled":  {
                    "type": "boolean",
                    "default": false,
                    "description": "If the extension should be forced on."
                }
            }
        },
        "mode": {
            "description": "A calculator, named the way ?type= names it. The aliases and the upstream path names work too.",
            "type": "string",
            "anyOf": [
                {
                    "title": "calculator",
                    "enum": [
                        "graphing",
                        "3d",
                        "geometry",
                        "notebook",
                        "matrix",
                        "scientific",
                        "fourfunction"
                    ]
                },
                {
                    "title": "alias",
                    "enum": [
                        "calculator",
                        "calc",
                        "graph",
                        "three",
                        "3",
                        "geo",
                        "note",
                        "matrices",
                        "sci",
                        "four",
                        "fourfn",
                        "4"
                    ]
                }
            ]
        }
    },
    "examples": [
        {
            "extensions": {
                "matrix": {
                    "name": "Matrices",
                    "description": "Add matrix support to the graphing calculator.",
                    "supports": ["graphing", "3d"],
                    "css": true
                }
            },
            "defaultExtensions": ["matrix"]
        }
    ]
}
